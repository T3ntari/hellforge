#HUMAN

// Trio — G major, gentler
@tempo 90

play chord(G, major) @dur:h @vel:mp
play note(B4) @dur:q @vel:mf
play note(D5) @dur:q @vel:p
play note(G5) @dur:h @vel:pp

play chord(C, major) @dur:h @vel:mp
play note(E5) @dur:q @vel:mf
play note(D5) @dur:q @vel:mp
play note(C5) @dur:e @vel:p
play note(B4) @dur:e @vel:pp

play chord(D, major) @dur:q @vel:mf
play note(F#5) @dur:e @vel:f
play note(G5) @dur:h @vel:mp
play chord(G, major) @dur:w @vel:mf
play note(G4) @dur:h @vel:p
