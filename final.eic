// EIC — E Index Clear (human-readable)
// Generated from: Nocturne_Bm.ei

// ===== PROJECT INDEX =====
project "Nocturne in B Minor"
composer "AI"
tempo 56

include "parts/opening.e" as opening
include "parts/development.e" as development
include "parts/climax.e" as climax

section "I. Opening" {
    play opening
}

section "II. Development" {
    play development after 500ms
}

section "III. Climax" {
    play climax after 500ms
}

