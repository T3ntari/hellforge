/* HELLFORGE v1.0.0.0 ALPHA — CORE-EXPANSION: REGAS */
// .eic toggleable mode — switch between #MACHINE and #HUMAN
   File:       toggle_full.eic
   Version:    v4 (toggleable mode) — .eic extension
   Status:     CURRENT STANDARD
   
   A complete composition with multiple mode toggles.
   Different sections (Intro, Verse, Chorus, Bridge, Outro) use
   different modes to achieve their unique musical character.

/* @bpm 100 — Starting tempo (slower for the intro). */
@bpm 100

/* ==================== INTRO #MACHINE ====================
   Algorithmic introduction — rising arpeggio generated by loop. */
#MACHINE

for $i = 0 to 8 {
    T{$i * 100} N{48 + $i * 2} D80 V{60 + $i * 5}
}

/* ==================== VERSE #HUMAN ====================
   Verse melody uses human-readable notes for singable lines. */
#HUMAN

play note(C4) @dur:q @vel:mp
play note(D4) @dur:q @vel:mp
play note(E4) @dur:h @vel:mf
play note(F4) @dur:q @vel:mp
play note(G4) @dur:q @vel:mp
play note(A4) @dur:h @vel:mf

/* ==================== CHORUS #MACHINE ====================
   Chorus uses machine mode for rhythmic drive and intensity.
   Faster tempo, denser notes. */
#MACHINE

T0 N48 D150 V100
T0 N52 D150 V100
T0 N55 D150 V100
T0 N60 D150 V100
T0 N55 D150 V100
T0 N52 D150 V100
T0 N48 D300 V120

/* ==================== BRIDGE #HUMAN ====================
   Bridge — softer, chord-based, using human mode. */
#HUMAN

@bpm 80   /* Tempo change for the bridge section */

play chord(D, minor)  @dur:h @vel:p
play chord(G, major)  @dur:h @vel:mp
play chord(C, major)  @dur:w @vel:mf

/* ==================== OUTRO #MACHINE ====================
   Outro returns to machine for a precise algorithmic fade-out. */
#MACHINE

@bpm 60   /* Slow down for the ending */

for $i = 0 to 5 {
    T{$i * 200} N{60} D{200 - $i * 30} V{80 - $i * 10}
}

/* Mode toggles per section:
   Intro:  #MACHINE  — algorithmic arpeggio
   Verse:  #HUMAN    — melodic, readable
   Chorus: #MACHINE  — rhythmic, intense
   Bridge: #HUMAN    — chordal, expressive
   Outro:  #MACHINE  — precise algorithmic fade */

// Run from project root: py ep.py compile samples/eic/toggle_full.eic
