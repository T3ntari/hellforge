# HELLFORGE environment — copy to .env and fill in YOUR values.
# Everything here is a placeholder; nothing private is committed.

# Optional: private package/verification registry (leave empty for local-only)
HF_REGISTRY=
HF_VERIFY_URL=
HF_VERIFY_TOKEN=

# Optional: LLM provider keys (hellgate / llm plugin)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
HELLGATE_CUSTOM_BASE_URL=
HELLGATE_CUSTOM_API_KEY=

# Ollama (local defaults)
HELLGATE_MODEL=
HELLGATE_OLLAMA_URL=http://127.0.0.1:11434/v1
